{#- Shared page shell: head, meta tags, favicon, skip link, footer shell.
    Pages extend this and fill the blocks: header, overlay, main, footer. -#}
{%- set pageTitle = title or site.title -%}
{%- set pageDescription = description or site.description -%}
{%- set canonical = site.url + page.url -%}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <meta name="theme-color" content="#f0ece3">
  <meta name="color-scheme" content="light">

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}{{ site.socialImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.socialImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.socialImage }}">
  <meta name="twitter:image:alt" content="{{ site.socialImageAlt }}">

  <script>
    // Apply the saved "Pause motion" choice before first paint.
    try { if (localStorage.getItem("dexteria-motion") === "paused") document.documentElement.dataset.motion = "paused"; } catch (e) {}
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap">

  {#- Layer order. Later layers win, so a section can override base styles. #}
  <style>@layer tokens, base, component, sections, page;</style>
  {%- css %}@layer tokens { {% include "src/css/tokens.css" %} }
@layer base { {% include "src/css/base.css" %} }{% endcss %}
  <link rel="stylesheet" href="{% getBundleFileUrl "css" %}">
  {%- if scripts !== false %}
  <script type="module" src="/src/js/main.js"></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% block header %}{% endblock %}
  {% block overlay %}{% endblock %}
  <main id="main" tabindex="-1">
    {% block main %}{% endblock %}
  </main>
  <footer class="site-footer">
    {% block footer %}{% endblock %}
  </footer>
</body>
</html>
