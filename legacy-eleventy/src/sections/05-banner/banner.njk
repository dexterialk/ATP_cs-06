{% css %}@layer sections { {% include "src/sections/05-banner/banner.css" %} }{% endcss %}
<section class="banner" aria-labelledby="banner-title" data-ball-state="banner">
  {#- The ball centres on this slot. The strip below covers its lower part,
      so the ball looks as if it rises out from behind the strip. -#}
  <div class="banner__ball-slot" data-ball-anchor="banner" aria-hidden="true"></div>
  <div class="banner__strip on-dark">
    <div class="container banner__inner">
      <p class="section-label">The Smart Ball</p>
      <h2 id="banner-title">A squeeze that tells you more.</h2>
      <p class="banner__text">A soft, squeezable ball with sealed electronics inside. It measures grip pressure and movement as you practise, and sends each session to the Dexteria app.</p>
    </div>
  </div>
</section>
