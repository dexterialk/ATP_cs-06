{%- set words = ["Move", "Mend", "Master", "Move", "Mend", "Master", "Move", "Mend", "Master"] -%}
{% css %}@layer sections { {% include "src/sections/03-marquee/marquee.css" %} }{% endcss %}
{#- Decorative repeat of the h1 slogan, so the moving text is hidden from
    assistive tech. The pause button is visible and keyboard operable. -#}
<div class="marquee" data-marquee data-ball-state="side">
  <div class="marquee__viewport" aria-hidden="true">
    <div class="marquee__track motion-loop">
      {%- for copy in [1, 2] %}
      <p>{% for word in words %}{% if loop.index is odd %}<b>{{ word }}</b>{% else %}{{ word }}{% endif %}<i></i>{% endfor %}</p>
      {%- endfor %}
    </div>
  </div>
  <button type="button" class="control marquee__pause" aria-pressed="false" data-marquee-pause>
    <svg class="marquee__icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
    <svg class="marquee__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5Z"/></svg>
    Pause <span class="visually-hidden">scrolling slogan</span>
  </button>
</div>
