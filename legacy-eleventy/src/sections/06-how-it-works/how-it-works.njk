{%- set steps = [
  { title: "Squeeze the ball", text: "Hold the Smart Ball and squeeze, release and move it as your practice plan suggests. Sensors sealed inside record grip pressure and movement." },
  { title: "Connect over Bluetooth", text: "The ball pairs with the Dexteria app on your phone or tablet over Bluetooth. Each session transfers on its own, with nothing to plug in." },
  { title: "See progress in the app", text: "After each session the app shows your grip pressure as a number and a simple chart, so you and your clinician can see how practice is going." }
] -%}
{% css %}@layer sections { {% include "src/sections/06-how-it-works/how-it-works.css" %} }{% endcss %}
<section class="steps" id="how-it-works" aria-labelledby="steps-title" data-ball-state="steps" data-steps style="--steps-count: {{ steps | length }}">
  <div class="steps__sticky">
    <div class="steps__inner container">
      <div class="steps__main">
        <p class="section-label">How it works</p>
        <h2 id="steps-title">Three steps from squeeze to progress.</h2>

        <ol class="steps__list" role="list">
          {%- for step in steps %}
          <li class="step{% if loop.first %} is-active{% endif %}" data-step{% if loop.first %} aria-current="step"{% endif %}>
            <span class="step__number" aria-hidden="true">0{{ loop.index }}</span>
            <h3 class="step__title"><span class="visually-hidden">Step {{ loop.index }}: </span>{{ step.title }}</h3>
            <p class="step__text">{{ step.text }}</p>
          </li>
          {%- endfor %}
        </ol>

        <div class="steps__controls">
          <button type="button" class="control" data-steps-prev aria-disabled="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            Previous step
          </button>
          <p class="steps__status" aria-hidden="true"><span data-steps-current>1</span> / {{ steps | length }}</p>
          <button type="button" class="control" data-steps-next>
            Next step
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <p class="visually-hidden" aria-live="polite" data-steps-live></p>
      </div>
      <div class="steps__ball-slot" data-ball-anchor="steps" aria-hidden="true"></div>
    </div>
  </div>
</section>
