{#- Content for the <footer> shell in base.njk. -#}
{% css %}@layer sections { {% include "src/sections/12-footer/footer.css" %} }{% endcss %}
<div class="footer container" data-ball-state="rest">
  <a class="footer__brand" href="/">
    <img class="footer__logo" src="/src/assets/images/logo/logo-mark.png" alt="" width="96" height="91" loading="lazy">
    <img class="footer__wordmark" src="/src/assets/images/logo/logo-text.png" alt="" width="336" height="50" loading="lazy">
    <span class="visually-hidden">Dexteria home</span>
  </a>
  <p class="footer__slogan">Move. Mend. Master.</p>
  <nav aria-label="Legal">
    <ul class="footer__links" role="list">
      <li><a href="/privacy/">Privacy notice</a></li>
      <li><a href="/accessibility/">Accessibility statement</a></li>
    </ul>
  </nav>
  <p class="footer__copy">© {{ site.year }} Dexteria · Team <span translate="no">{{ site.team }}</span></p>
</div>
