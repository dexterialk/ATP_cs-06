{#- Each image is a placeholder. The alt text states the sample data shown,
    so the picture's information is never visual-only. -#}
{%- set features = [
  { title: "Your grip pressure, as a number",
    text: "After each session, the app shows your grip pressure as a single number, so small changes are easy to spot.",
    img: "grip-number.svg",
    alt: "Example app card with sample data: today's grip pressure is 42, up 3 from the last session, with a small chart of the last seven sessions rising from 34 to 42." },
  { title: "Compare with your other hand",
    text: "See how your practising hand is doing next to your unaffected hand, shown as a percentage of its grip.",
    img: "hand-compare.svg",
    alt: "Example chart with sample data: two bars compare grip pressure. The unaffected hand is 100 percent; the practising hand is 71 percent of it." },
  { title: "Squeeze and movement games",
    text: "Short games turn squeezes, holds and tilts into play, which makes regular practice easier to keep up.",
    img: "games.svg",
    alt: "Example game screen: a balloon rises as you squeeze the ball, and you hold it level with a dashed target line." },
  { title: "Difficulty set by your clinician",
    text: "Your clinician can set how hard each exercise is, so the games match the practice plan you agreed together.",
    img: "clinician.svg",
    alt: "Example settings card with sample values chosen by a clinician: difficulty level 3 of 5, hold for 5 seconds, 10 repetitions." },
  { title: "Saves automatically offline",
    text: "No signal? Sessions save automatically and sync to the app when you are back online.",
    img: "offline.svg",
    alt: "Example list of three practice sessions saved while offline, each marked as waiting to sync." }
] -%}
{% css %}@layer sections { {% include "src/sections/07-key-features/key-features.css" %} }{% endcss %}
<section class="features" id="features" aria-labelledby="features-title" data-ball-state="corner" data-features>
  <div class="features__sticky">
    <div class="features__head container">
      <div>
        <p class="section-label">Key features</p>
        <h2 id="features-title">Made for everyday practice.</h2>
      </div>
      <div class="features__controls">
        <button type="button" class="control" data-features-prev aria-disabled="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          Previous feature
        </button>
        <p class="features__status" aria-hidden="true"><span data-features-current>1</span> / {{ features | length }}</p>
        <button type="button" class="control" data-features-next>
          Next feature
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <p class="visually-hidden" aria-live="polite" data-features-live></p>
    </div>

    <div class="features__viewport">
      <ol class="features__track" role="list" data-features-track>
        {%- for feature in features %}
        <li class="feature" data-feature>
          <img class="feature__image" src="/src/assets/images/features/{{ feature.img }}" alt="{{ feature.alt }}" width="480" height="360" loading="lazy" decoding="async">
          <div class="feature__body">
            <h3 class="feature__title">{{ feature.title }}</h3>
            <p class="feature__text">{{ feature.text }}</p>
          </div>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</section>
