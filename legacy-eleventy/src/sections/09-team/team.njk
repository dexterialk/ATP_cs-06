{#- PLACEHOLDER team list. Replace names, roles and photos (see README.md).
    Photos use alt="" because the name is printed right next to each one. -#}
{%- set members = [
  { name: "Team member 1", role: "Product owner", photo: "avatar-placeholder.svg" },
  { name: "Team member 2", role: "Scrum master", photo: "avatar-placeholder.svg" },
  { name: "Team member 3", role: "UX and UI design", photo: "avatar-placeholder.svg" },
  { name: "Team member 4", role: "Front-end development", photo: "avatar-placeholder.svg" },
  { name: "Team member 5", role: "Hardware and sensors", photo: "avatar-placeholder.svg" },
  { name: "Team member 6", role: "Testing and research", photo: "avatar-placeholder.svg" }
] -%}
{% css %}@layer sections { {% include "src/sections/09-team/team.css" %} }{% endcss %}
<section class="team" id="team" aria-labelledby="team-title" data-ball-state="off-screen">
  <div class="container">
    <p class="section-label reveal">The team</p>
    <h2 id="team-title" class="reveal" style="--d: .1s">Meet team <span translate="no">CS-06</span>.</h2>
    <p class="section-intro reveal" style="--d: .2s">We are a student team on the University of Westminster Agile Team Project module (2026/27), building Dexteria for Coursework 1.</p>
    <ul class="team__grid" role="list">
      {%- for member in members %}
      <li class="team-card reveal" style="--d: {{ (loop.index0 % 3) * 0.08 }}s">
        <img class="team-card__photo" src="/src/assets/images/team/{{ member.photo }}" alt="" width="400" height="400" loading="lazy" decoding="async">
        <h3 class="team-card__name">{{ member.name }}</h3>
        <p class="team-card__role">{{ member.role }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
