{% css %}@layer sections { {% include "src/sections/04-problem/problem.css" %} }{% endcss %}
<section class="problem on-dark" id="why" aria-labelledby="problem-title" data-ball-state="behind-panel">
  <div class="problem__inner container">
    <figure class="problem__media reveal">
      {#- PLACEHOLDER: replace with the licensed photo (see README.md). -#}
      <img src="/src/assets/images/problem/problem-placeholder.svg"
           alt="Placeholder illustration of two cupped hands holding a soft, sage-grey exercise ball"
           width="800" height="1000" loading="lazy" decoding="async">
    </figure>
    <div class="problem__copy">
      <p class="section-label reveal">Why it matters</p>
      <h2 id="problem-title" class="reveal" style="--d: .1s">Home practice is hard to keep up.</h2>
      <p class="reveal" style="--d: .2s">Hand exercises often happen alone at home, between appointments. Without feedback, it is easy to lose track, lose motivation, or stop.</p>
      <p class="reveal" style="--d: .3s">Clinicians have little to go on between sessions. They see how you are doing on the day, not how your practice went the week before.</p>
      <p class="problem__note reveal" style="--d: .4s">Dexteria is a wellness product. It supports your physiotherapy and does not replace it.</p>
    </div>
  </div>
</section>
