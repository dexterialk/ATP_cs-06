{% css %}@layer sections { {% include "src/sections/10-waitlist/waitlist.css" %} }{% endcss %}
<section class="waitlist" id="waitlist" aria-labelledby="waitlist-title" data-ball-state="waitlist">
  <div class="waitlist__grid container">
    <div class="waitlist__card">
      <p class="section-label">Something worth waiting for</p>
      <h2 id="waitlist-title">Stay in the loop.</h2>
      <p class="waitlist__intro">Be part of the journey. Subscribe for updates, sneak peeks, and the official Dexteria launch.</p>

      {#- Without JavaScript this posts straight to Brevo. With JavaScript,
          waitlist.js validates first and sends it with fetch. -#}
      <form class="waitlist-form" action="{{ brevoAction }}" method="post" data-waitlist-form>
        <div class="field">
          <label class="field__label" for="waitlist-email">Email address <span class="field__required">(required)</span></label>
          <input class="field__input" id="waitlist-email" name="EMAIL" type="email" inputmode="email"
                 autocomplete="email" autocapitalize="off" spellcheck="false" required
                 aria-describedby="waitlist-email-error">
          <p class="field__error" id="waitlist-email-error" data-error-for="waitlist-email"></p>
        </div>

        <div class="field field--check">
          <div class="check">
            {#- No name attribute: Brevo does not receive this field. The form
                cannot be sent until it is ticked. See README.md. -#}
            <input class="check__input" id="waitlist-consent" type="checkbox" required
                   aria-describedby="waitlist-consent-error" data-consent>
            <label class="check__label" for="waitlist-consent">I agree to Dexteria storing my email address to send me launch updates. I can unsubscribe at any time. <span class="field__required">(required)</span></label>
          </div>
          <p class="field__help">Read our <a href="/privacy/">privacy notice</a> to see how we use and protect your data.</p>
          <p class="field__error" id="waitlist-consent-error" data-error-for="waitlist-consent"></p>
        </div>

        {#- Brevo spam trap: must stay empty. Hidden from everyone. -#}
        <div class="waitlist-form__trap" aria-hidden="true">
          <label for="waitlist-check">Leave this field empty</label>
          <input id="waitlist-check" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off">
        </div>
        <input type="hidden" name="locale" value="en">

        <button type="submit" class="button waitlist-form__submit">
          <span class="waitlist-form__spinner" aria-hidden="true"></span>
          Subscribe
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </button>

        <p class="waitlist-form__status" role="status" aria-live="polite" data-form-status></p>
      </form>
      <p class="waitlist__note">No spam. Just updates worth opening.</p>
    </div>

    {#- The ball expands from the corner into this slot and spins once. -#}
    <div class="waitlist__ball-slot" data-ball-anchor="waitlist" aria-hidden="true"></div>
  </div>
</section>
