{#- Smart Ball: one persistent, decorative ball in a fixed layer.
    Markup only. smart-ball.js renders the ball into .smart-ball__spin.
    To swap the PNG for a 3D model, see README.md in this folder. -#}
{%- set ballSrc = "/src/assets/ball/smart-ball.png" -%}
{% css %}@layer component { {% include "src/components/smart-ball/smart-ball.css" %} }{% endcss %}
<link rel="preload" as="image" href="{{ ballSrc }}" fetchpriority="high">
<div class="ball-layer" aria-hidden="true" data-smart-ball-layer>
  <div class="smart-ball" data-smart-ball data-src="{{ ballSrc }}" data-state="hero">
    <div class="smart-ball__offset">
      <div class="smart-ball__float">
        <div class="smart-ball__spin"></div>
      </div>
    </div>
  </div>
</div>
